// mangobar config (JSONC).
{
    "layer": "top",
    "height": 30,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,
    // "sys-interval": 2,  // default refresh interval (seconds) for polled modules

    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [
    	"clock#time"
    ],
    "modules-right": [
        "tray",
        // "keymode",
        // "keyboardlayout",
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
	"backlight",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
	"max-length": 250,
        "format": "{}"
    },
    "keyboardlayout": {
        "format": "{short}"
    },

    "network": {
        // Placeholders: {ifname}/{} interface, {ipaddr}/{ip} IPv4 address,
        // {ssid}/{essid}, {signal} icon, {strength}/{signal-percent} percent,
        // {status}, {type}, {icon}, {down}/{up} (speed in format-alt)
        "format": "{icon} {ifname}",
        "format-wifi": "{signal} {ssid}",
        "format-disconnected": "{icon}",
        "icon-wifi": "󰖩",
        "icon-ethernet": "󰈀",
        "icon-disconnected": "󰖪",
        "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-alt": "↓{down} ↑{up}"
        // "interval": 1  // seconds; omit to use the global "sys-interval"
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {load}%"
        // "interval": 1  // seconds; omit to use the global "sys-interval"
    },
    "memory": {
        "format": " {}%"
        // "interval": 5  // seconds; omit to use the global "sys-interval"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {bt}",
        "format-muted": "󰝟 {volume}% {bt}",
        "icons": ["󰝟", "󰕿", "󰕾"],
        // "icon-bluetooth": "󰂯",
        "scroll-step": 5,
        "max-volume": 150,
	"on-click": "pavucontrol"
    },
    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "icon-charging": "󰂄",
        "icon-full": "󰁹",
        "icon-ac": ""
        // "hide-on-ac": true
    },
    "backlight": {
    "format": "{icon}",
    "icons": ["󰃞", "󰃟", "󰃝", "󰃝", "󰃠", "󰃠", "󰃠"],
     "scroll-step": 2
    },

    "clock#time": {
        "format": " {:L%H:%M}"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 1
    },

    "custom/power": {
        "format": "󰣇",
        "on-click": "wlogout"
    }
}
